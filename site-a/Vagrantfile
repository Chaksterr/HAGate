require "yaml"

# BLOC 1 : lire les valeurs du site
cfg  = YAML.load_file(File.join(__dir__, "ansible", "group_vars", "all.yml"))
name = cfg["site_name"]

# BLOC 2 : la liste des VM = ton plan d'adressage
NODES = [
  ["#{name}-mysql",          cfg["db_ip"]],
  ["#{name}-web",            cfg["web_ip"]],
  ["#{name}-haproxy-backup", cfg["ha_backup_ip"]],
  ["#{name}-haproxy-master", cfg["ha_master_ip"]]   # la dernière lance Ansible
]
LAST = NODES.last[0]

Vagrant.configure("2") do |config|
  # BLOC 3 : réglages communs
  config.vm.box = "ubuntu/jammy64"      # Ubuntu 22.04
  config.vm.box_check_update = false

  # BLOC 4 : la même recette pour chaque VM
  NODES.each_with_index do |(vm_name, ip), i|
    config.vm.define vm_name do |node|
      node.vm.hostname = vm_name

      # SSH fixe pour l'inventaire : 2201, 2202, 2203, 2204
      node.vm.network "forwarded_port", guest: 22, host: 2201 + i, id: "ssh"

      # 2e carte réseau = ton LAN (enp0s8)
      node.vm.network "private_network", ip: ip, netmask: "255.255.255.0",
                      virtualbox__intnet: cfg["lan_net"]

      node.vm.provider "virtualbox" do |vb|
        vb.name   = vm_name
        vb.memory = 1024
        vb.cpus   = 1
        vb.customize ["modifyvm", :id, "--natnet1", "192.168.250.0/24"]
        vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
      end

      # BLOC 5 : Ansible, lancé une seule fois, depuis la dernière VM
      if vm_name == LAST
        node.vm.provision "network", type: "ansible" do |a|
          a.playbook       = "ansible/network.yml"
          a.inventory_path = "ansible/inventory.ini"
          a.limit          = "all"
        end

        node.vm.provision "main", type: "ansible" do |a|
          a.playbook       = "ansible/site.yml"
          a.inventory_path = "ansible/inventory.ini"
          a.limit          = "all"
          a.tags = ENV["TAGS"].split(",") if ENV["TAGS"]
        end
      end
    end
  end
end