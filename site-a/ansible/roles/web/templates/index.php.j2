<?php
mysqli_report(MYSQLI_REPORT_OFF);
$db = @new mysqli("{{ db_ip }}", "{{ db_user }}", "{{ db_pass }}", "{{ db_name }}");

// ---- CREATE / UPDATE / DELETE ----
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !$db->connect_errno) {
    $action = $_POST['action'] ?? '';
    $id     = (int)($_POST['id'] ?? 0);
    $name   = trim($_POST['name'] ?? '');
    $job    = trim($_POST['job_title'] ?? '');
    $email  = trim($_POST['email'] ?? '');
    $valid  = $name !== '' && $job !== '' && filter_var($email, FILTER_VALIDATE_EMAIL);

    if ($action === 'add' && $valid) {
        $st = $db->prepare("INSERT INTO employees (name, job_title, email) VALUES (?, ?, ?)");
        $st->bind_param("sss", $name, $job, $email);
        $st->execute();
    } elseif ($action === 'update' && $valid && $id > 0) {
        $st = $db->prepare("UPDATE employees SET name = ?, job_title = ?, email = ? WHERE id = ?");
        $st->bind_param("sssi", $name, $job, $email, $id);
        $st->execute();
    } elseif ($action === 'delete' && $id > 0) {
        $st = $db->prepare("DELETE FROM employees WHERE id = ?");
        $st->bind_param("i", $id);
        $st->execute();
    }
    header("Location: /");   // reload the page, so F5 does not resend the form
    exit;
}

$editId = (int)($_GET['edit'] ?? 0);
?>
