<?php
try {
    $pdo = new PDO("mysql:host={{ db_ip }};dbname={{ db_name }};charset=utf8mb4", "{{ db_user }}", "{{ db_pass }}", [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
} catch (Exception $e) {
    http_response_code(500);
    exit("Database error");
}

if ($_SERVER["REQUEST_METHOD"] === "POST") {
    $action = $_POST["action"] ?? "";
    $id     = (int)($_POST["id"] ?? 0);
    $name   = mb_substr(trim($_POST["name"] ?? ""), 0, 100);
    $job    = mb_substr(trim($_POST["job_title"] ?? ""), 0, 100);
    $email  = mb_substr(trim($_POST["email"] ?? ""), 0, 150);
    $valid  = $name !== "" && $job !== "" && filter_var($email, FILTER_VALIDATE_EMAIL);
    if ($action === "create" && $valid) {
        $pdo->prepare("INSERT INTO employees (name, job_title, email) VALUES (?, ?, ?)")->execute([$name, $job, $email]);
    } elseif ($action === "update" && $id > 0 && $valid) {
        $pdo->prepare("UPDATE employees SET name = ?, job_title = ?, email = ? WHERE id = ?")->execute([$name, $job, $email, $id]);
    } elseif ($action === "delete" && $id > 0) {
        $pdo->prepare("DELETE FROM employees WHERE id = ?")->execute([$id]);
    }
    header("Location: /");
    exit;
}

$rows = $pdo->query("SELECT id, name, job_title, email FROM employees ORDER BY id")->fetchAll(PDO::FETCH_ASSOC);
$h = fn($s) => htmlspecialchars($s, ENT_QUOTES, "UTF-8");
?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Directory - {{ site_name }}</title>
  <style>
    body { font-family: sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
    .row { display: flex; gap: .5rem; margin: .5rem 0; align-items: center; }
    form { display: flex; gap: .5rem; margin: 0; }
    input[type=text], input[type=email] { padding: .3rem; width: 190px; }
    small { color: #666; }
  </style>
</head>
<body>
  <h1>Directory - {{ site_name }}</h1>

  <h3>Add an employee</h3>
  <form method="post">
    <input type="hidden" name="action" value="create">
    <input type="text" name="name" placeholder="Name" maxlength="100" required>
    <input type="text" name="job_title" placeholder="Job title" maxlength="100" required>
    <input type="email" name="email" placeholder="Email" maxlength="150" required>
    <button type="submit">Add</button>
  </form>

  <h3>Employees (<?= count($rows) ?>)</h3>
  <?php foreach ($rows as $r): ?>
    <div class="row">
      <form method="post">
        <input type="hidden" name="action" value="update">
        <input type="hidden" name="id" value="<?= (int)$r["id"] ?>">
        <input type="text" name="name" value="<?= $h($r["name"]) ?>" maxlength="100" required>
        <input type="text" name="job_title" value="<?= $h($r["job_title"]) ?>" maxlength="100" required>
        <input type="email" name="email" value="<?= $h($r["email"]) ?>" maxlength="150" required>
        <button type="submit">Save</button>
      </form>
      <form method="post">
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="id" value="<?= (int)$r["id"] ?>">
        <button type="submit">Delete</button>
      </form>
    </div>
  <?php endforeach; ?>

  <p><small>site {{ site_name }} - served by <?= $h(gethostname()) ?></small></p>
</body>
</html>
